# Large runtime data/cache is produced and consumed by GitHub Actions workers,
# not by the Vercel MCP gateway.
data/**
experiments/**
.github/**
output/**
results/**

# Remote-sensing binary artifacts must never enter the Vercel function bundle.
*.tif
*.tiff
*.hdf
*.h4
*.h5
*.nc
*.zip
*.b64

# Python build/runtime noise.
__pycache__/**
*.pyc
.pytest_cache/**
.venv/**
